# Copy to .env.local for local development, and add the same values in
# Vercel under Project Settings > Environment Variables.

# API key from https://resend.com/api-keys (required for the contact form to send)
RESEND_API_KEY=

# Inbox that receives contact form requests
CONTACT_TO_EMAIL=info@arllp.ca

# Sender shown on the emails. Must use a domain verified in Resend (arllp.ca).
CONTACT_FROM_EMAIL="A&R LLP Website <website@arllp.ca>"
